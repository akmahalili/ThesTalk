# Copy to .env for local testing only. On Vercel, set these in Project → Settings → Environment Variables.
# Never commit real keys.

# AI providers: set at least ONE. Each key switches that AI on in Settings → Choose AI.
# Free (default): Google Gemini key from https://aistudio.google.com/apikey (free tier; Google may use free-tier data to improve its products)
GEMINI_API_KEY=
# Optional: try this Gemini model first (default gemini-3.5-flash-lite, then gemini-3.1-flash-lite)
GEMINI_MODEL=
# Paid: Claude (Anthropic) key from https://platform.claude.com (Max/Team plans include monthly API credits)
ANTHROPIC_API_KEY=
# Optional: Claude model (default claude-sonnet-5-5, falls back to claude-haiku-5-5)
CLAUDE_MODEL=
# Paid: ChatGPT (OpenAI) key from https://platform.openai.com (also enables OpenAI voice transcription)
OPENAI_API_KEY=
# Optional: ChatGPT model (default gpt-5.6-terra, then gpt-5.4-mini, gpt-4.1-mini)
OPENAI_MODEL=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Optional: default AI when the app has not chosen one (gemini, claude or openai)
AI_PROVIDER=

THESTALK_AI_ACCESS_CODE=

# Required for "Find real references" (free key: https://openalex.org/settings/api)
OPENALEX_API_KEY=
# Optional contact email sent to OpenAlex
OPENALEX_EMAIL=

# Optional: switch an AI off without deleting its key, e.g. AI_DISABLED=openai,claude
AI_DISABLED=

# Sync between devices (v2.2): created automatically when a Vercel Blob store is connected to the project.
# BLOB_READ_WRITE_TOKEN=

# Second free AI (v2.4): Groq free tier, no card needed. Also used automatically when the Gemini free limit is used up.
# GROQ_API_KEY=
