# Copy to .env for local testing only. On Vercel, set these in Project → Settings → Environment Variables.
# Never commit real keys.

# AI provider: set ONE of these.
# Free option: Google Gemini key from https://aistudio.google.com/apikey (free tier; Google may use free-tier data to improve its products)
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.8-flash, falls back to gemini-3.5-flash-lite)
GEMINI_MODEL=
# Paid option: OpenAI (also enables AI voice transcription)
OPENAI_API_KEY=
THESTALK_AI_ACCESS_CODE=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Required for "Find real references" (free key: https://openalex.org/settings/api)
OPENALEX_API_KEY=
# Optional contact email sent to OpenAlex
OPENALEX_EMAIL=
